rules_version = '2';
// Skills domain contract for emulator / integration. Production shares a project:
// merge the two match blocks into its existing rules; do not replace other domains.
service cloud.firestore {
  match /databases/{database}/documents {
    match /skillsCatalogs/{version} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /skillsUsers/{uid}/events/{eventId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['id','schemaVersion','catalogVersion','type','skillId','stageId','at','payload'])
          && d.keys().hasOnly(['id','schemaVersion','catalogVersion','type','skillId','stageId','at','payload'])
          && d.id == eventId && eventId.matches('^[a-zA-Z0-9_-]{1,128}$')
          && d.schemaVersion == 1 && d.catalogVersion == 1
          && d.type in ['legacy','stage','hold','session']
          && d.skillId in ['muscle-up','planche','front-lever','back-lever','handstand-pushup','v-sit','pistol-squat','human-flag','one-arm-pullup','dragon-flag','hefesto','one-arm-handstand','one-arm-pushup','shrimp-squat']
          && d.stageId is string && d.stageId.size() < 180
          && d.stageId.matches('^' + d.skillId + '/[a-z0-9-]+$')
          && d.at is string && d.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$')
          && d.payload is map
          && (d.type != 'hold' || (d.payload.duration is number && d.payload.duration > 0))
          && (d.type != 'session' || d.payload.exercises is list)
          && (d.type != 'stage' || d.payload.mastered is bool);
      }
      allow read: if owner();
      allow create: if owner() && valid();
      // Idempotent replay is allowed; history edits and deletions are denied.
      allow update: if owner() && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
